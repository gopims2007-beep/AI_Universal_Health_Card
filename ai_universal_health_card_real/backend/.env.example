APP_NAME=AI Universal Health Card
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://healthapp:healthapp_password@127.0.0.1:3306/ai_health_card
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
MAX_UPLOAD_MB=15
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional SMTP for real email verification/password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
